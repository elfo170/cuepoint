{
  "name": "cuepoint",
  "private": true,
  "version": "0.1.0",
  "description": "CuePoint — curadoria musical sobre o SoundCloud",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-env.ps1",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "npm run e2e -w @cuepoint/extension",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gradle.ps1",
    "android:check": "npm run android -- test assembleDebug"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
