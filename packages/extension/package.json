{
  "name": "@cuepoint/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "e2e:soundcloud:live": "node scripts/build.mjs && playwright test -c playwright.live.config.ts",
    "dev": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@cuepoint/core": "^0.1.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  }
}
