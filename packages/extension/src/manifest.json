{
  "manifest_version": 3,
  "name": "CuePoint",
  "short_name": "CuePoint",
  "description": "Curadoria musical rápida durante a reprodução no SoundCloud.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CuePoint",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["keyguard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms", "downloads", "notifications"],
  "host_permissions": ["https://soundcloud.com/*"]
}
