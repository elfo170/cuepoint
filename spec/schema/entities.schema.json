{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CuePoint — dados de domínio das entidades sincronizadas",
  "description": "Gerado a partir de packages/core/src/model.ts. Cada registro também guarda id, created_at, updated_at, _v e _c.",
  "entities": {
    "track": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "soundcloud_urn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^soundcloud:tracks:\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "soundcloud_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string"
        },
        "artwork_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_source": {
          "type": "string",
          "minLength": 1
        },
        "merged_into": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "soundcloud_urn",
        "soundcloud_url",
        "title",
        "artist",
        "artwork_url",
        "metadata_source",
        "merged_into",
        "deleted_at"
      ],
      "additionalProperties": false
    },
